PORT=3001

# Generate with: openssl rand -hex 64
JWT_SECRET=__GENERATE_ME__

ALLOWED_ORIGINS=http://localhost:8000,https://construmaster.example.com

# Postgres password — shared by the postgres container (dev + prod compose) and
# embedded in DATABASE_URL. Use the same value for both. Generate with:
#   openssl rand -hex 32
POSTGRES_PASSWORD=__GENERATE_ME__

# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Dev (host process): HOST=localhost.
# Prod (compose): the app container overrides this to use HOST=postgres so it
# resolves on the compose network; leave this pointing at localhost for dev.
DATABASE_URL=postgres://construmaster:__GENERATE_ME__@localhost:5432/construmaster_v2

# Optional: set once to bootstrap admin from prisma/seed.js. Generate with: openssl rand -base64 24
ADMIN_BOOTSTRAP_PASSWORD=__GENERATE_ME__

# BCCR SDDE — token JWT desde sdd.bccr.fi.cr → Mi perfil → Generar token.
# Email del usuario registrado en SDDE (informativo, lo loguea valideSubscription).
BCCR_TOKEN=
BCCR_EMAIL=

# Gemini OCR para facturas no-electrónicas.
# Obtené la API key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo OCR. Opciones (verificadas 2026-05-29):
#   - gemini-3.5-flash         (más capaz, recomendado, ~3-5× más caro que lite)
#   - gemini-flash-lite-latest (alias auto-upgrade al último lite disponible)
#   - gemini-3.1-flash-lite    (lite estable, OCR de cotizaciones simples)
#   - gemini-2.5-flash-lite    (fallback)
OCR_MODEL=gemini-3.5-flash

# BullMQ / Redis — procesamiento async de facturas (XML + OCR).
# Si está vacío, las facturas se procesan inline (síncrono) en el request HTTP
# — comportamiento histórico, backwards compat 100%. Para activar el worker,
# apuntá a un Redis disponible (ej. `redis://redis:6379` desde compose, o
# `redis://localhost:6379` si exponés el puerto al host).
REDIS_URL=

# Concurrency del worker (jobs paralelos). Default 2.
WORKER_CONCURRENCY=2

# Validación XSD opt-in del XML de facturas Hacienda v4.4. Default OFF.
# Si `true`, antes de parsear el XML lo validamos contra los XSDs oficiales
# en `server/schemas/V4.4/*.xsd` usando `xmllint-wasm`. Si falla, la factura
# queda `status='error'` con `errorMessage='XSD validation failed: ...'`.
XSD_VALIDATE=false
