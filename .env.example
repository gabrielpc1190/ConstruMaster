# ConstruMaster — environment variables example (COMMITABLE)
# Copy this file to `.env` and fill every __GENERATE_ME__ / placeholder value.
# `.env` is gitignored. Recommend `chmod 600 .env`.
#
# IMPORTANT: docker/web.entrypoint.sh aborts the container if it detects
# __GENERATE_ME__ or known insecure defaults at startup. Don't deploy with
# placeholders.

# ─── Gemini API (OCR de facturas no-electrónicas) ────────────────────
# Obtener en: https://aistudio.google.com/apikey
GEMINI_API_KEY=__GENERATE_ME__
# Optional: override the OCR model (default: gemini-3.1-flash-lite)
# OCR_MODEL=gemini-3.1-flash-lite

# ─── BCCR (Indicadores Económicos, tipo de cambio) ───────────────────
# Portal: https://sdd.bccr.fi.cr/es/IndicadoresEconomicos/Inicio/
# Token: Login → Mi perfil → Generar token (es un JWT).
BCCR_EMAIL=your-email@example.com
BCCR_TOKEN=__GENERATE_ME__
BCCR_NOMBRE_APP=ConstruMaster

# ─── Django ──────────────────────────────────────────────────────────
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=__GENERATE_ME__
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=construmaster.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://construmaster.example.com

# ─── Database / Redis ────────────────────────────────────────────────
# Generate POSTGRES_PASSWORD with:
#   openssl rand -base64 32
# Then mirror the same password into DATABASE_URL.
POSTGRES_USER=construmaster
POSTGRES_PASSWORD=__GENERATE_ME__
POSTGRES_DB=construmaster
DATABASE_URL=postgres://construmaster:__GENERATE_ME__@postgres:5432/construmaster
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# ─── Cloudflare Tunnel ───────────────────────────────────────────────
# Obtener desde dash.cloudflare.com → Zero Trust → Networks → Tunnels.
# Required only when running `docker compose --profile production`.
CLOUDFLARED_TOKEN=

# ─── Email (opcional, para password reset futuro) ────────────────────
# DEFAULT_FROM_EMAIL=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
