# ConstruMaster — environment variables example (COMMITABLE)
# Copy this file to `.env` and fill values. `.env` is gitignored.

# ─── Gemini API (OCR de facturas no-electrónicas) ────────────────────
GEMINI_API_KEY=AIza...your-key-here

# ─── BCCR (Indicadores Económicos, tipo de cambio) ───────────────────
BCCR_EMAIL=your-email@example.com
BCCR_TOKEN=your-bccr-token
BCCR_NOMBRE_APP=ConstruMaster

# ─── Django ──────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=generate-with-secrets.token_urlsafe-50
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=construmaster.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://construmaster.example.com

# ─── Database / Redis ────────────────────────────────────────────────
DATABASE_URL=postgres://construmaster:changeme@postgres:5432/construmaster
POSTGRES_USER=construmaster
POSTGRES_PASSWORD=changeme
POSTGRES_DB=construmaster
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# ─── Cloudflare Tunnel ───────────────────────────────────────────────
CLOUDFLARED_TOKEN=

# ─── Email (opcional) ────────────────────────────────────────────────
# DEFAULT_FROM_EMAIL=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
